{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "quiz-bank.json", "use": "@vercel/static" },
    { "src": "teacher-mcq.json", "use": "@vercel/static" },
    { "src": "projects/**", "use": "@vercel/static" },
    { "src": "business-analysis/**", "use": "@vercel/static" },
    { "src": "data-engineering/**", "use": "@vercel/static" },
    { "src": "data-validation-lab/schemas/**", "use": "@vercel/static" },
    { "src": "api/tutor.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/tutor", "dest": "/api/tutor.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
